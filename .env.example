# =============================================================================
# .env.example — canonical template; copy to `.env` and fill in real values.
# This file IS tracked by git. The real .env is git-ignored.
# =============================================================================

# ---- NVIDIA NIM (adversarial borrower voice) --------------------------------
# Get a key from https://build.nvidia.com/. Required when NEG_LLM_ENABLED=1.
NVIDIA_API_KEY=

# Set to 1 to activate the live NIM voice; 0 (or unset) uses the template
# fallback bank. The environment ships safely with the fallback either way.
NEG_LLM_ENABLED=0

# ---- Weights & Biases (training telemetry) ----------------------------------
# Get a key from https://wandb.ai/authorize. If unset, training runs offline.
WANDB_API_KEY=
WANDB_PROJECT=negotiation-rl-training
