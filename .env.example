# =============================================================================
# .env.example — template for local environment variables
# =============================================================================
# Copy this file to `.env` (in the same directory) and fill in the real values.
# `.env` is git-ignored; `.env.example` is tracked so reviewers / judges /
# new contributors know which variables to provide.
#
# The application uses `python-dotenv` to load these values at process start.
# Variables defined in your shell still take precedence over the .env file
# (dotenv only fills in unset variables by default).
# =============================================================================

# ─── NVIDIA NIM (Llama-3.1-70B-Instruct) ───────────────────────────────────
# Required when NEG_LLM_ENABLED=1.  Without it the env silently falls back to
# the deterministic template bank.  Get your key at https://build.nvidia.com/
NVIDIA_API_KEY=

# ─── Voice toggle (optional) ────────────────────────────────────────────────
# Set to 1 to route borrower replies through the live NIM endpoint.
# Leave unset (default) for hermetic / offline runs that use templates only.
NEG_LLM_ENABLED=
