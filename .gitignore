# =============================================================================
# Project-root .gitignore
# =============================================================================
# Keep this file conservative.  The repo's working tree is `negotiation-env/`
# which has its own (tighter) .gitignore — patterns here apply to anything
# placed at the root of the workspace (env files, scratch notebooks, etc.).
# =============================================================================

# ─── Secrets / local environment variables ────────────────────────────────────
# `.env` carries real API keys and must never be committed.
# `.env.example` is the safe template (no real values) and MUST stay tracked,
# so we explicitly un-ignore it with `!`.
.env
.env.*
!.env.example

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# ─── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ─── Logs / scratch ───────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
