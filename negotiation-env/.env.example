# =============================================================================
# .env.example — canonical configuration template for the Fast-Hybrid system.
# =============================================================================
#
# Copy this file to `.env` (in this directory OR the repo root — both work)
# and fill in the values you actually have.
#
#     cp negotiation-env/.env.example negotiation-env/.env
#
# This template IS tracked by git. The real `.env` is git-ignored. Never paste
# real keys into this file.
#
# How the loader resolves these variables
# ---------------------------------------
# Both `environment/response_generator.py` and `environment/llm_judge.py` call
# `dotenv.find_dotenv(usecwd=True)`, which walks UPWARD from the current
# working directory looking for a `.env`. The first one wins, and existing
# shell exports always override `.env` values. That means:
#
#   • A `.env` in `negotiation-env/` shadows one at the repo root.
#   • `export NVIDIA_API_KEY=...` in your shell wins over both.
#   • CI / Docker / Kubernetes can mount secrets normally; no `.env` needed.
#
# =============================================================================
# 1. NVIDIA NIM API KEY  (required for NEG_LLM_ENABLED *and* NEG_LLM_JUDGE_ENABLED)
# =============================================================================
#
# Single key, two consumers:
#   • environment/response_generator.py — the adversarial *borrower voice*
#     LLM (Llama-3.1-70B-Instruct). Activated by NEG_LLM_ENABLED below.
#   • environment/llm_judge.py — the qualitative reward Judge (also
#     Llama-3.1-70B-Instruct by default). Activated by NEG_LLM_JUDGE_ENABLED.
#
# Get one at https://build.nvidia.com/. If left as a placeholder string, both
# subsystems silently fall back to safe defaults (template responses for the
# voice; 0.0 / 0.0 scores for the judge) — training never crashes for a
# missing key.
NVIDIA_API_KEY=

# =============================================================================
# 2. WEIGHTS & BIASES API KEY  (optional)
# =============================================================================
#
# When set, `training/train_grpo.py` logs in and pushes per-step metrics. When
# unset (or left blank), training runs in WandB-offline mode and the dashboard
# is simply not populated.
#
# Get one at https://wandb.ai/authorize.
WANDB_API_KEY=

# Optional WandB project name. Defaults are baked into train_grpo.py if unset.
WANDB_PROJECT=negotiation-rl-training

# =============================================================================
# 3. NEG_LLM_ENABLED  (live borrower voice toggle)
# =============================================================================
#
# 1 → adversary uses the live NIM LLM to generate borrower replies.
# 0 → adversary returns deterministic template strings from the legacy
#     pick_template() bank. The state machine, rewards, and termination
#     logic are unchanged either way; only the *prose* the agent reads
#     differs.
#
# Default OFF so `pytest` and CI stay hermetic. Flip to 1 once a real
# NVIDIA_API_KEY is configured.
NEG_LLM_ENABLED=0

# =============================================================================
# 4. NEG_LLM_JUDGE_ENABLED  ⭐  CRITICAL — DORMANT BY DEFAULT  ⭐
# =============================================================================
#
# This is the master switch for the Phase-2 LLM Judge that scores every
# eligible turn on (empathy, strategy) inside `reward.compose()`.
#
#   1 → Judge is LIVE. After the deterministic gates pass, every turn calls
#       Llama-3.1-70B-Instruct. The judge's empathy_score replaces the
#       deescalation reward and strategy_score replaces trust_building.
#       This is the configuration the Fast-Hybrid system was designed for.
#
#   0 → Judge is DORMANT. compose() never opens a network connection.
#       deescalation and trust_building are forced to 0.0 every turn. Useful
#       for offline experiments, debugging, and CI runs that must not pay
#       NIM costs.
#
# IMPORTANT: This flag is INDEPENDENT of NEG_LLM_ENABLED. You can run a
# template-only borrower voice (NEG_LLM_ENABLED=0) with a live judge
# (NEG_LLM_JUDGE_ENABLED=1), or vice-versa.
#
# A real NVIDIA_API_KEY is required for the live mode; placeholder values
# from this file are detected and treated as "not configured" → judge falls
# back to dormant ("disabled") even if you flipped this flag to 1.
NEG_LLM_JUDGE_ENABLED=0

# =============================================================================
# 5. LLM_JUDGE_TIMEOUT_S  (judge call hard ceiling, seconds)
# =============================================================================
#
# Per-call wall clock cap for the Judge. Clamped to [1.0, 30.0]. If the call
# does not return inside this budget, the judge raises internally, returns a
# JudgeScore with reason="timeout" and zero scores, and GRPO continues
# without delay.
#
# Default 4 seconds — safe under typical NIM p95 latency, fast enough for hot
# RL loops. Lower it (e.g. 2s) to be even more aggressive about not blocking
# rollout collection; raise it (e.g. 10s) if NIM is consistently slow in
# your region.
LLM_JUDGE_TIMEOUT_S=4

# =============================================================================
# 6. NEGOTIATION_ENV_URL  (FastAPI environment base URL)
# =============================================================================
#
# `training/train_grpo.py` reads this at startup and points
# `NegotiationEnvClient` at it. Pulling it from env-var instead of hardcoding
# `http://127.0.0.1:8000` means the same training script runs unchanged in:
#
#   • Local dev   →  http://127.0.0.1:8000   (matches `uvicorn ... --port 8000`)
#   • CI / Docker →  http://negotiation-env.svc.cluster.local
#   • HF Spaces   →  https://your-space.hf.space
#
# Default (when unset) is local: http://127.0.0.1:8000.
NEGOTIATION_ENV_URL=http://127.0.0.1:8000

# =============================================================================
# Cheat sheet for common deployment profiles
# =============================================================================
#
# (a) Hermetic CI / local pytest:
#         leave everything blank or 0 — fully deterministic, zero outbound HTTP.
#
# (b) Local dev with live borrower voice but no judge:
#         NVIDIA_API_KEY=nvapi-...
#         NEG_LLM_ENABLED=1
#         NEG_LLM_JUDGE_ENABLED=0
#
# (c) Full Fast-Hybrid GRPO training (the Gate-5 configuration):
#         NVIDIA_API_KEY=nvapi-...
#         WANDB_API_KEY=wandb_v1_...
#         NEG_LLM_ENABLED=1
#         NEG_LLM_JUDGE_ENABLED=1
#         LLM_JUDGE_TIMEOUT_S=4
#         NEGOTIATION_ENV_URL=http://127.0.0.1:8000
#
# (d) Cost-controlled dry-run (template borrower, live judge for soft scores):
#         NVIDIA_API_KEY=nvapi-...
#         NEG_LLM_ENABLED=0
#         NEG_LLM_JUDGE_ENABLED=1
